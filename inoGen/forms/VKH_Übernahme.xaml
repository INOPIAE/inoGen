<Window x:Class="VKH_Übernahme"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:inoGen"
        mc:Ignorable="d"
        Title="VKH_Übernahme" Height="450" Width="1300">
    <Grid>
        <DockPanel LastChildFill="False">
            <TextBlock Text="VK Heirat Übernahme"
               FontSize="18"
               FontWeight="Bold"
               DockPanel.Dock="Top"
               Margin="0 0 0 10" />
            <DataGrid x:Name="dgEintrag"
              DockPanel.Dock="Left"
              Width="300"
              AutoGenerateColumns="True"
              AutoGeneratedColumns="dgEintrag_AutoGeneratedColumns"
              Margin="0 0 10 0"
              MouseDoubleClick="dgEintrag_MouseDoubleClick" />
            <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Quelle:" Width="40" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtQuelle" Width="200" />
                        <TextBlock Text="Seite:" Width="30" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSeite" Width="40" />
                        <TextBlock Text="Nummer:" Width="50" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtNr" Width="60" />
                        <TextBlock Text="URL:" Width="30" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtURL" Width="350" Foreground="Blue" TextDecorations="Underline"/>
                        <TextBlock Text="Quelle Seite:" Width="70" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtQuelleSeite" Width="60" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="HDatum:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtHDatum" Width="200" />
                        <TextBlock Text="Dimissionsdatum:" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDimDatum" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 5">
                        <TextBlock Text="Bemerkung:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtInfo" Width="700"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 10 0 5">
                        <TextBlock Text="Index H:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtIndexH" Width="100"/>
                        <TextBlock Text="Index Btg:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtIndexBtg" Width="100"/>
                        <TextBlock Text="Index Bt:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtIndexBt" Width="100"/>
                    </StackPanel>
                    <StackPanel  Orientation="Horizontal" Margin="0 10 0 5">
                        <Button x:Name="btnBtg" Content="Btg" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnVBtg" Content="V Btg" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnMBtg" Content="M Btg" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnBt" Content="Bt" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnVBt" Content="V Btg" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnMBt" Content="M Btg" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnZ1" Content="Z 1" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnZ2" Content="Z 2" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnZ3" Content="Z 3" Width="50" Margin="5 5 5 5" />
                        <Button x:Name="btnZ4" Content="Z 4" Width="50" Margin="5 5 5 5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 5">
                        <TextBlock Text="Vornamen:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtV" Width="200"/>
                        <TextBlock Text="Nachname:" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtN" Width="200"/>
                        <TextBlock Text="Geb Datum:" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtGeb" Width="70"/>
                        <TextBlock x:Name="lblVTag" Text=" " Width="100" VerticalAlignment="Center" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Wohnort:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWO" Width="200"/>
                        <TextBlock Text="Heimatort:" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtHO" Width="200"/>
                        <TextBlock Text="Zusatz:" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtZu" Width="200"/>
                    </StackPanel>



                    <StackPanel Orientation="Horizontal" Margin="0 10 0 5">
                        <TextBlock Text="Sex Zg:" Width="60" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSex" Width="20"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 5">
                        <Button x:Name="btnNewPerson" Content="Neu" Width="50" Margin="5 5 5 5" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
