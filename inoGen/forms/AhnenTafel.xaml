<Window x:Class="AhnenTafel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:local="clr-namespace:inoGen"
        mc:Ignorable="d"
        Title="AhnenTafel" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zeile 0: Toolbar -->
        <StackPanel Orientation="Horizontal" 
                Grid.Row="0" 
                HorizontalAlignment="Left" 
                Margin="5">
            <TextBlock Text="Person:" Width="70" VerticalAlignment="Center" />
            <TextBox x:Name="txtPerson" Width="200" Margin="0,0,10,0"/>
            <TextBlock Text="Komprimiert:" Width="90" VerticalAlignment="Center"/>
            <CheckBox x:Name="ckbCompress" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Mit Quellen:" Width="90" VerticalAlignment="Center"/>
            <CheckBox x:Name="ckbWithSources" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="btnSearch" Content="Suchen" Width="80" Margin="5" Click="btnSearch_Click"/>
            <Button x:Name="btnOK" Content="OK" Width="80" Margin="5" Click="btnOK_Click"/>
            <Button x:Name="btnCSV" Content="CSV" Width="80" Margin="5" Click="btnCSV_Click"/>
            <Button x:Name="btnReport" Content="Bericht" Width="80" Margin="5" Click="btnReport_Click"/>
            <Button x:Name="btnChart" Content="Ahnentafel" Width="80" Margin="5" Click="btnChart_Click"/>
            <Button x:Name="btnMap" Content="Karte" Width="80" Margin="5" Click="btnMap_Click"/>
            <Button x:Name="btnCancel" Content="Abbrechen" Width="80" Margin="5" Click="btnCancel_Click"/>
        </StackPanel>

        <!-- Zeile 1: Content mit Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Markdown Viewer -->
            <md:MarkdownScrollViewer x:Name="MdView" 
                                 Grid.Column="0" 
                                 Margin="10"/>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                      Width="5" 
                      HorizontalAlignment="Stretch" 
                      Background="LightGray"/>

            <!-- Optionen-Panel -->
            <Border Grid.Column="2" 
                BorderBrush="LightGray" 
                BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <StackPanel Margin="10">
                        <Border x:Name="progressBorder"
        Margin="5,10,5,0"
        Padding="8"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="4"
        Background="#FFF8F8F8"
        Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="txtProgressLabel"
                   Text="Verarbeitung läuft..."
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
                                <ProgressBar x:Name="pbProgress"
                     Height="16"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Ahnentafel-Optionen" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>

                        <Expander Header="Format" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <RadioButton x:Name="rbA1" Content="DIN A1"  Margin="0,3"/>
                                <RadioButton x:Name="rbA2" Content="DIN A2" Margin="0,3"/>
                                <RadioButton x:Name="rbA3" Content="DIN A3" Margin="0,3"/>
                                <RadioButton x:Name="rbA4" Content="DIN A4" IsChecked="True" Margin="0,3"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Darstellung" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <RadioButton x:Name="rbGen4" Content="4 Generationen (DIN A4)" IsChecked="True" Margin="0,3"/>
                                <RadioButton x:Name="rbGen7" Content="7 Genrationen" Margin="0,3"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Farben" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10,5">
                                <RadioButton x:Name="rbFO" Content="ohne" IsChecked="True" Margin="0,3"/>
                                <RadioButton x:Name="rbFG" Content="Geschlechterfarben" Margin="0,3"/>
                                <RadioButton x:Name="rbFZ" Content="Zweigfarben" Margin="0,3"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
