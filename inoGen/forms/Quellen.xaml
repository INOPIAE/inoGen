<Window x:Class="Quellen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:inoGen"
        mc:Ignorable="d"
        Title="Quellen" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="False">
            <TextBlock Text="Quellen"
          FontSize="18"
          FontWeight="Bold"
          DockPanel.Dock="Top"
          Margin="0 0 0 10" />
            <DataGrid x:Name="dgQuellen"
         DockPanel.Dock="Left"
         Width="450"
         AutoGenerateColumns="True"
         AutoGeneratedColumns="dgQuellen_AutoGeneratedColumns"
         Margin="0 0 10 0"
         MouseDoubleClick="dgQuellen_MouseDoubleClick" />
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                    <TextBlock Text="Quelle:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtQuelle" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                    <TextBlock Text="Quelle kurz:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtQuelleKurz" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                    <TextBlock Text="Info:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtInfo" Width="200"/>
                </StackPanel>
               
                <Button x:Name="btnDelete" Content="Löschen" Width="100" Margin="0 10 0 0" Click="btnDelete_Click"/>
                <Button x:Name="btnNew" Content="Neu" Width="100" Margin="0 10 0 0" Click="btnNew_Click"/>
                <Button x:Name="btnSave" Content="Speichern" Width="100" Margin="0 10 0 0" HorizontalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
