<UserControl x:Class="QuellenZitate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:inoGen"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <!-- Filter -->
            <RowDefinition Height="Auto"/>

            <!-- DataGrid: variabler Bereich -->
            <RowDefinition Height="*"/>

            <!-- Schaltflächen -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- FILTER -->
        <!-- ===================================================== -->
        <Border Grid.Row="0"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnFilter" Grid.Column="0"
                        Content="Filter"
                        Height="30"
                        Margin="5" Click="btnFilter_Click" />

                <TextBlock Grid.Column="1"
                           Text="Quelle:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <ComboBox Grid.Column="2"
                  x:Name="cbQuelle"
                  Height="25"
                  SelectedIndex="0">


                </ComboBox>

                <TextBlock Grid.Column="3"
                           Text="Ereignis:"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"/>

                <ComboBox Grid.Column="4"
                  x:Name="cbEreignisArt"
                  Height="25"
                  SelectedIndex="0">

                </ComboBox>

                <TextBlock Grid.Column="5"
                           Text="Jahr:"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"/>

                <TextBox Grid.Column="6"
                         x:Name="txtJahr"
                         Height="25"/>
                
                <TextBlock Grid.Column="7"
                           Text="Bd:"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"/>

                <TextBox Grid.Column="8"
                         x:Name="txtBd"
                         Height="25"/>

                <TextBlock Grid.Column="9"
                           Text="Seite:"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"/>

                <TextBox Grid.Column="10"
                         x:Name="txtSeite"
                         Height="25"/>
                <TextBlock Grid.Column="11"
                           Text="Nummer:"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0"/>

                <TextBox Grid.Column="12"
                         x:Name="txtNummer"
                         Height="25"/>
            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- DATAGRID -->
        <!-- ===================================================== -->
        <DataGrid Grid.Row="1"
                  x:Name="dgQuellZitate"
                  Margin="10"
                  AutoGenerateColumns="True"
                  AutoGeneratedColumns="dgQuellZitate_AutoGeneratedColumns"
                  SelectionMode="Single"/>


        <!-- ===================================================== -->
        <!-- SCHALTFLÄCHEN -->
        <!-- ===================================================== -->
        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="0,1,0,0"
                Padding="10">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="btnNeu"
                        Content="Neu"
                        Width="100"
                        Height="30"
                        Margin="5"
                        Click="btnNeu_Click" />

                <Button x:Name="btnKopieren"
                        Content="Kopieren"
                        Width="100"
                        Height="30"
                        Margin="5"
                        Click="btnKopieren_Click" />
                
                <Button x:Name="btnLoeschen"
                        Content="Löschen"
                        Width="100"
                        Height="30"
                        Margin="5"/>

                <Button x:Name="btnSpeichern"
                        Content="Speichern"
                        Width="100"
                        Height="30"
                        Margin="5"
                        Click="btnSpeichern_Click" />

            </StackPanel>

        </Border>

    </Grid>
</UserControl>
