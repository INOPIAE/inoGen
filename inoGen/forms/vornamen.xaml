<UserControl x:Class="vornamen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:inoGen"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Suche -->
            <RowDefinition Height="*"/>
            <!-- Inhalt -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- 🔍 Suchzeile -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Vorname:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSuche"
                 Width="200"
                 Margin="5,0,0,0"
                 TextChanged="TxtSuche_TextChanged"/>
            <CheckBox x:Name="ChkSoundex" 
                      Content="Soundex Suche" 
                      Margin="5,0,0,0"
                      VerticalAlignment="Center" 
                      FlowDirection="RightToLeft" >
                <CheckBox.Resources>
                    <!-- Verhindert, dass der Text von rechts nach links geschrieben wird -->
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </Style>
                </CheckBox.Resources>
            </CheckBox>
        </StackPanel>

        <!-- 📋 Inhalt -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid links -->
            <DataGrid x:Name="DgVorname"
                  Grid.Column="0"
                  AutoGenerateColumns="True"
                  AutoGeneratedColumns="DgVorname_AutoGeneratedColumns"
                  IsReadOnly="True"
                  MouseDoubleClick="DgVorname_MouseDoubleClick">

            </DataGrid>

            <!-- Details rechts -->
            <Grid Grid.Column="1" Margin="15,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="ID:" Width="80"/>
                    <TextBox x:Name="TxtID" Width="150" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <Label Content="Vorname:" Width="80"/>
                    <TextBox x:Name="TxtVorname" Width="200"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <Label Content="Stammname:" Width="80"/>
                    <TextBox x:Name="TxtStammname" Width="200"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 🔘 Buttons -->
        <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
            <Button Content="Auswählen"
                Width="100"
                Margin="5"
                Click="BtnSelect_Click"/>
            <Button Content="Speichern"
                Width="100"
                Margin="5"
                Click="BtnSave_Click"/>
            <Button Content="Schließen"
                Width="100"
                Margin="5"
                IsCancel="True"/>
        </StackPanel>
    </Grid>
</UserControl>
