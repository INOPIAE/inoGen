<Window x:Class="AutoCorrection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:inoGen"
        mc:Ignorable="d"
        Title="AutoCorrection" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Ersetze / Durch -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ersetze:"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="txtReplace"/>

            <TextBlock Grid.Column="2"
                       Text="durch:"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
            <TextBox Grid.Column="3"
                     x:Name="txtWith"/>
        </Grid>

        <!-- 2. Verwaltungsbuttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Neu"
                    Width="90"
                    Margin="0,0,10,0"
                    x:Name="BtnNew"/>

            <Button Content="Ändern"
                    Width="90"
                    Margin="0,0,10,0"
                    x:Name="BtnUpdate"/>

            <Button Content="Löschen"
                    Width="90"
                    x:Name="BtnDelete"/>
        </StackPanel>

        <!-- 3. Liste -->
        <ListView Grid.Row="2"
                  x:Name="lstAutoCorrect"
                  MouseDoubleClick="LstAutoCorrect_DoubleClick">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ersetze"
                                    Width="250"
                                    DisplayMemberBinding="{Binding ReplaceText}"/>
                    <GridViewColumn Header="Durch"
                                    Width="250"
                                    DisplayMemberBinding="{Binding WithText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 4. Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Abbrechen"
                    Width="100"
                    Margin="0,0,10,0"
                    x:Name="BtnCancel"/>

            <Button Content="Speichern schließen"
                    Width="160"
                    IsDefault="True"
                    x:Name="BtnSave"/>
        </StackPanel>
    </Grid>
</Window>
