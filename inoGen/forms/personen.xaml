<UserControl x:Class="personen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:inoGen"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1000">

    <Grid>

        <!-- ===================================================== -->
        <!-- 2 Spalten / 2 Zeilen                                  -->
        <!-- ===================================================== -->

        <Grid.ColumnDefinitions>
            <!-- Personen -->
            <ColumnDefinition Width="500"/>

            <!-- rechter Bereich -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- StackPanel + AdditionalContent + Quellen -->
            <RowDefinition Height="*"/>

            <!-- Quellzitate -->
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- LINKS: PERSONEN                                       -->
        <!-- ===================================================== -->

        <DataGrid x:Name="dgPersonen"
                  Grid.Column="0"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  AutoGenerateColumns="True"
                  AutoGeneratedColumns="dgPersonen_AutoGeneratedColumns"
                  Margin="0 0 10 0"
                  MouseDoubleClick="dgPersonen_MouseDoubleClick"/>


        <!-- ===================================================== -->
        <!-- RECHTER OBERER BEREICH                                -->
        <!-- StackPanel + AdditionalContent + Quellen             -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              Grid.Row="0">

            <Grid.ColumnDefinitions>

                <!-- StackPanel -->
                <ColumnDefinition Width="320"/>

                <!-- AdditionalContent -->
                <ColumnDefinition Width="320"/>

                <!-- Quellen -->
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- STACKPANEL                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="0"
                        Margin="0 0 10 0">

                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <Button x:Name="btnFamile"
                            Content="Familie"
                            Width="60"
                            Margin="0 0 5 0"
                            Click="btnFamile_Click"/>

                    <Button x:Name="btnVater"
                            Content="Vater"
                            Width="60"
                            Margin="0 0 5 0"
                            Click="btnVater_Click"/>

                    <Button x:Name="btnMutter"
                            Content="Mutter"
                            Width="60"
                            Margin="0 0 5 0"
                            Click="btnMutter_Click"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="PS:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtPS"
                             Width="200"
                             IsEnabled="False"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Vornamen:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtVorname"
                             Width="200"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Nachname:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtNachname"
                             Width="200"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Konfession:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="cbKonfession"
                              Width="200"
                              DisplayMemberPath="Konfessionkurz"
                              SelectedValuePath="tblKonfessionID"
                              SelectionChanged="cbKonfession_SelectionChanged"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Geschlecht:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <ComboBox x:Name="cbSex"
                              Width="100"
                              SelectedIndex="0">

                        <ComboBoxItem Content=" " />
                        <ComboBoxItem Content="m" />
                        <ComboBoxItem Content="w" />

                    </ComboBox>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Info:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtInfo"
                             Width="200"/>

                </StackPanel>


                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 5">

                    <TextBlock Text="Familysearch ID:"
                               Width="100"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtFSID"
                             Width="100"/>

                    <Button x:Name="btnFS"
                            Content="..."
                            Width="30"
                            Margin="5 0 0 0"
                            Click="btnFS_Click"/>

                </StackPanel>


                <Button x:Name="btnSave"
                        Content="Speichern"
                        Width="100"
                        Margin="0 10 0 0"
                        HorizontalAlignment="Center"/>

                <Button x:Name="btnNew"
                        Content="Neu"
                        Width="100"
                        Margin="0 10 0 10"
                        Click="btnNew_Click"/>


                <!-- ============================================= -->
                <!-- EREIGNISSE                                    -->
                <!-- ============================================= -->

                <DataGrid x:Name="dgEreignis"
                          AutoGenerateColumns="True"
                          AutoGeneratedColumns="dgEreignis_AutoGeneratedColumns"
                          Margin="0 0 0 0"
                          MouseDoubleClick="dgEreignis_MouseDoubleClick"
                          Height="150"/>

                <Button x:Name="btnNewEvent"
                        Content="Neue Ereignis"
                        Width="100"
                        Margin="0 10 0 0"
                        Click="btnNewEvent_Click"/>
                
                
                
                <DataGrid x:Name="dgSpouse"
                          AutoGenerateColumns="True"
                          AutoGeneratedColumns="dgSpouse_AutoGeneratedColumns"
                          Margin="0 0 0 0"
                          MouseDoubleClick="dgSpouse_MouseDoubleClick"
                          Height="150"/>

                <Button x:Name="btnSpouse"
                        Content="Partner"
                        Width="100"
                        Margin="0 10 0 0"
                        Click="btnSpouse_Click"/>
            </StackPanel>


            <!-- ================================================= -->
            <!-- ADDITIONAL CONTENT                                -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="0 0 5 0">

                <ContentControl x:Name="AdditionalContent"/>

            </Border>


            <!-- ================================================= -->
            <!-- QUELLEN                                           -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5 0 0 0">

                <ContentControl x:Name="Quellen"/>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- QUELLZITATE                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              Grid.Row="1"
              Margin="0 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0"
                       Text="Quellzitate"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0 0 0 5"/>


            <DataGrid x:Name="dgQuellZitate"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      AutoGeneratedColumns="dgQuellZitate_AutoGeneratedColumns"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"/>

        </Grid>

    </Grid>

</UserControl>